# ==========================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Note: Do not enter real API keys in this file.
# Copy this file to '.env' and fill in your actual keys locally.
# ==========================================

# 1. Fireflies API (For meeting transcript extraction)
FIREFLIES_API_KEY=your_fireflies_api_key_here

# 2. OpenAI API (For NLP and AI Agents)
OPENAI_API_KEY=sk-your_openai_api_key_here

# 3. Google Workspace Credentials (Google Docs, Slides, Sheets)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 4. n8n Webhook Configuration
N8N_WEBHOOK_URL_PROD=https://your-n8n-instance.com/webhook/meeting-trigger